/* ================= TỶ GIÁ ================= */
function getTyGia(tk) { _auth(tk); var s = sh_('TY_GIA'); var rows = []; if (s && s.getLastRow() >= 5) { s.getRange(5, 1, s.getLastRow() - 4, 3).getValues().forEach(function (r) { if (r[0] && money_(r[1])) rows.push({ ngay: fmtDate_(r[0]), tyGia: money_(r[1]), ghiChu: r[2] || '' }); }); } rows.sort(function (a, b) { return parseDate_(b.ngay) - parseDate_(a.ngay); }); return { rows: rows, moiNhat: tyGiaMoi_() }; }
function saveTyGia(tk, r) { _auth(tk); requireRole_(['Admin', 'KeToan']); var tg = money_(r.tyGia); if (tg <= 0) throw new Error('Nhập tỷ giá hợp lệ.'); var d = r.ngay ? parseDate_(r.ngay) : new Date(); var key = fmtDate_(d); var s = sh_('TY_GIA'); var row = -1; if (s && s.getLastRow() >= 5) { var v = s.getRange(5, 1, s.getLastRow() - 4, 1).getValues(); for (var i = 0; i < v.length; i++) { if (v[i][0] && fmtDate_(v[i][0]) === key) { row = 5 + i; break; } } } if (row < 0) row = firstEmptyRow_('TY_GIA', 1, 5); s.getRange(row, 1).setValue(d); s.getRange(row, 2).setValue(tg); s.getRange(row, 3).setValue(r.ghiChu || ''); SpreadsheetApp.flush(); return getTyGia(); }
function deleteTyGia(tk, ngay) { _auth(tk); requireRole_(['Admin']); var s = sh_('TY_GIA'); if (s && s.getLastRow() >= 5) { var v = s.getRange(5, 1, s.getLastRow() - 4, 1).getValues(); for (var i = 0; i < v.length; i++) { if (v[i][0] && fmtDate_(v[i][0]) === ngay) { s.getRange(5 + i, 1, 1, 3).clearContent(); return getTyGia(); } } } throw new Error('Không tìm thấy tỷ giá ngày ' + ngay); }

/* ================= NHẬP HÀNG (hàng Taobao về) ================= */
function getImports(tk) { _auth(tk); var s = sh_('NHAP_HANG'); var out = []; if (s && s.getLastRow() >= 5) { var v = s.getRange(5, 1, s.getLastRow() - 4, 14).getValues(); for (var i = v.length - 1; i >= 0 && out.length < 100; i--) { var r = v[i]; if (!r[1]) continue; out.push({ ngay: fmtDate_(r[0]), ma: String(r[1]), ten: String(r[2] || ''), mau: String(r[4] || ''), size: String(r[5] || ''), sl: money_(r[6]), giaTe: money_(r[7]), tyGiaAp: money_(r[10]), von: money_(r[11]), thanhTien: money_(r[12]), ghiChu: r[13] || '' }); } } return out; }
function addImport(tk, p) { _auth(tk); requireRole_(['Admin', 'Kho', 'BanHang']); var prods = {}; readProducts_().forEach(function (x) { prods[x.ma] = x; }); if (!prods[String(p.ma)]) throw new Error('Không tìm thấy mã hàng ' + p.ma); var row = firstEmptyRow_('NHAP_HANG', 2, 5); ensureFormulas_('NHAP_HANG', 5, row, [3, 4, 11, 12, 13, 15, 16, 17, 18]); var s = sh_('NHAP_HANG'); s.getRange(row, 1).setValue(p.ngay ? parseDate_(p.ngay) : new Date()); s.getRange(row, 2).setValue(String(p.ma)); s.getRange(row, 5).setValue(String(p.mau || '')); s.getRange(row, 6).setValue(String(p.size || '')); s.getRange(row, 7).setValue(Math.max(1, money_(p.sl) || 1)); if (money_(p.giaTe) > 0) s.getRange(row, 8).setValue(money_(p.giaTe)); if (money_(p.tyGia) > 0) s.getRange(row, 9).setValue(money_(p.tyGia)); if (money_(p.ship) > 0) s.getRange(row, 10).setValue(money_(p.ship)); s.getRange(row, 14).setValue(p.ghiChu || ''); SpreadsheetApp.flush(); return getImports(); }
