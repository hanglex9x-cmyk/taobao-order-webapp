function doiMatKhau(tk, cu, moi) { var ph = _auth(tk); moi = String(moi || ''); if (moi.length < 4) throw new Error('Mật khẩu mới phải có ít nhất 4 ký tự.'); var s = taiKhoanSheet_(); var v = s.getRange(2, 1, Math.max(1, s.getLastRow() - 1), 5).getValues(); for (var i = 0; i < v.length; i++) { if (String(v[i][0]).toLowerCase() === ph.u) { if (String(v[i][1]) !== bamMatKhau_(ph.u, String(cu || ''))) throw new Error('Mật khẩu cũ chưa đúng.'); s.getRange(i + 2, 2).setValue(bamMatKhau_(ph.u, moi)); return true; } } throw new Error('Không tìm thấy tài khoản.'); }
function getCurrentUser(tk) { if (tk) _auth(tk); if (_PHIEN) { var pm = { Admin: ['*'], BanHang: ['dashboard', 'taodon', 'donhang', 'hanghoa', 'tonkho', 'khachhang'], Kho: ['dashboard', 'donhang', 'hanghoa', 'tonkho'], KeToan: ['dashboard', 'donhang', 'khachhang'], Xem: ['dashboard', 'donhang', 'hanghoa', 'tonkho', 'khachhang'] }; return { email: _PHIEN.u, name: _PHIEN.ten, role: _PHIEN.role, active: true, perms: pm[_PHIEN.role] || [] }; } throw new Error('Bạn chưa đăng nhập.'); }
function requireRole_(roles) { var u = getCurrentUser(); if (u.role === 'Admin') return u; if (roles.indexOf(u.role) < 0) throw new Error('Tài khoản vai trò ' + u.role + ' không có quyền làm việc này.'); return u; }

/* ================= CẤU HÌNH SHOP ================= */
function getShopConfig(tk) { _auth(tk); var s = sh_('CAU_HINH'); var m = {}; if (s && s.getLastRow() >= 5) { s.getRange(5, 1, s.getLastRow() - 4, 2).getValues().forEach(function (r) { if (r[0]) m[String(r[0]).trim()] = r[1]; }); } return { tenShop: m['Tên shop'] || 'LOAN BÌNH ĐỒ MÚA', sdt: m['SĐT / Zalo'] || '', diaChi: m['Địa chỉ'] || '', fb: m['Facebook / Website'] || '', nganHang: m['Ngân hàng'] || '', stk: m['Số tài khoản'] || '', chuTK: m['Chủ tài khoản'] || '', loiNhan: m['Lời nhắn cuối đơn'] || '', user: getCurrentUser() }; }

/* ================= ĐỌC DỮ LIỆU GỐC ================= */
function readProducts_() { var s = sh_('MA_SP'); if (!s || s.getLastRow() < 5) return []; return s.getRange(5, 1, s.getLastRow() - 4, 20).getValues().filter(function (r) { return r[0]; }).map(function (r) { return { ma: String(r[0]), ten: r[1] || '', hinh: String(r[2] || ''), link: String(r[3] || ''), giaTe: money_(r[4]), shipDV: money_(r[5]), tyGia: money_(r[6]), vonUoc: money_(r[7]), vonBQ: money_(r[8]), giaBan: money_(r[9]), lai: money_(r[10]), tongNhap: money_(r[11]), tongBan: money_(r[12]), ton: money_(r[13]), canhBao: String(r[15] || '') }; }); }
function variantRows_() { var s = sh_('TON_KHO'); if (!s || s.getLastRow() < 5) return []; return s.getRange(5, 2, s.getLastRow() - 4, 9).getValues().filter(function (r) { return r[0]; }).map(function (r) { return { ma: String(r[0]), ten: r[1] || '', mau: String(r[3] || ''), size: String(r[4] || ''), nhap: money_(r[5]), ban: money_(r[6]), ton: money_(r[7]), canDat: money_(r[8]) }; }); }
function dsMauSize_() { var s = sh_('MA_SP'); var mau = [], size = []; if (s && s.getLastRow() >= 5) { var v = s.getRange(5, 20, s.getLastRow() - 4, 2).getValues(); v.forEach(function (r) { if (r[0]) mau.push(String(r[0])); if (r[1]) size.push(String(r[1])); }); } return { mau: mau, size: size }; }
function tyGiaMoi_() { var s = sh_('TY_GIA'); var best = null; if (s && s.getLastRow() >= 5) { s.getRange(5, 1, s.getLastRow() - 4, 3).getValues().forEach(function (r) { if (!r[0] || !money_(r[1])) return; var d = parseDate_(r[0]); if (!best || d > best.d) best = { d: d, ngay: fmtDate_(r[0]), tyGia: money_(r[1]) }; }); } return best ? { ngay: best.ngay, tyGia: best.tyGia } : { ngay: '', tyGia: 0 }; }
function getProducts(tk) { _auth(tk); var vr = variantRows_(); var byMa = {}; vr.forEach(function (x) { (byMa[x.ma] = byMa[x.ma] || []).push(x); }); var prods = readProducts_().map(function (p) { p.variants = byMa[p.ma] || []; return p; }); var ds = dsMauSize_(); return { products: prods, dsMau: ds.mau, dsSize: ds.size, tyGia: tyGiaMoi_() }; }
function readCustomers_() { var s = sh_('MA_KH'); if (!s || s.getLastRow() < 5) return []; return s.getRange(5, 1, s.getLastRow() - 4, 11).getValues().filter(function (r) { return r[0]; }).map(function (r) { return { ma: String(r[0]), ten: r[1] || '', sdt: String(r[2] || ''), diaChi: r[3] || '', fb: String(r[4] || ''), nhom: r[5] || '', slMua: money_(r[6]), tongMua: money_(r[7]), daTra: money_(r[8]), conNo: money_(r[9]), canhBao: String(r[10] || '') }; }); }
function getCustomers(tk) { _auth(tk); return readCustomers_(); }
