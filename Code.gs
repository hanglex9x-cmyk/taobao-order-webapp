/* Tìm dòng trống đầu tiên theo cột khoá (từ dòng 5) — không đụng dòng có dữ liệu */
function firstEmptyRow_(sheetName, colIdx, startRow) { var s = sh_(sheetName); var last = Math.max(s.getMaxRows(), startRow); var v = s.getRange(startRow, colIdx, last - startRow + 1, 1).getValues(); for (var i = 0; i < v.length; i++) { if (!v[i][0]) return startRow + i; } throw new Error(sheetName + ' đã hết dòng trống.'); }
function findRowByKey_(sheetName, colIdx, startRow, key) { var s = sh_(sheetName); if (!s || s.getLastRow() < startRow) return -1; var v = s.getRange(startRow, colIdx, s.getLastRow() - startRow + 1, 1).getValues(); for (var i = 0; i < v.length; i++) { if (String(v[i][0]) === String(key)) return startRow + i; } return -1; }
/* Nếu dòng đích chưa có công thức (ngoài vùng phủ sẵn) thì chép công thức từ dòng mẫu — chỉ chép cột công thức */
function ensureFormulas_(sheetName, tplRow, targetRow, formulaCols) { var s = sh_(sheetName); if (targetRow === tplRow) return; var f = s.getRange(targetRow, formulaCols[0]).getFormula(); if (f) return; formulaCols.forEach(function (c) { s.getRange(tplRow, c).copyTo(s.getRange(targetRow, c)); }); }

/* ================= KHÁCH HÀNG ================= */
function slugify_(s) { return String(s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().replace(/[^a-z0-9]+/g, ''); }
function saveCustomer(tk, c) { _auth(tk); requireRole_(['Admin', 'BanHang', 'KeToan']); var s = sh_('MA_KH'); if (!String(c.ten || '').trim()) throw new Error('Chưa nhập tên khách hàng.'); c.ma = String(c.ma || '').trim().toLowerCase(); if (!c.ma) throw new Error('Admin phải tự nhập Mã KH cho khách (không dấu, không khoảng trắng).'); if (/\s/.test(c.ma)) throw new Error('Mã KH không được chứa khoảng trắng.'); var all = readCustomers_(); var sdt = String(c.sdt || '').trim(); if (sdt) { var trungSDT = all.filter(function (x) { return x.sdt === sdt && x.ma !== c.ma; }); if (trungSDT.length) throw new Error('SĐT ' + sdt + ' đã thuộc khách "' + trungSDT[0].ten + '" (' + trungSDT[0].ma + ').'); } var row = findRowByKey_('MA_KH', 1, 5, c.ma); if (row < 0) { row = firstEmptyRow_('MA_KH', 1, 5); ensureFormulas_('MA_KH', 5, row, [7, 8, 9, 10, 11]); } s.getRange(row, 1, 1, 6).setValues([[c.ma, c.ten, sdt, c.diaChi || '', c.fb || '', c.nhom || 'Khách lẻ']]); return getCustomers(); }
function deleteCustomer(tk, ma) { _auth(tk); requireRole_(['Admin']); var co = groupOrders_().some(function (o) { return o.maKH === String(ma); }); if (co) throw new Error('Khách đã có đơn hàng — không xoá để tránh mất lịch sử.'); var kh = null; readCustomers_().forEach(function (c) { if (c.ma === String(ma)) kh = c; }); if (kh && kh.conNo > 0) throw new Error('Khách còn nợ — không xoá được.'); var row = findRowByKey_('MA_KH', 1, 5, ma); if (row < 0) throw new Error('Không tìm thấy khách ' + ma); sh_('MA_KH').getRange(row, 1, 1, 6).clearContent(); return getCustomers(); }

/* ================= HÀNG HOÁ ================= */
function saveProduct(tk, p) { _auth(tk); requireRole_(['Admin', 'Kho']); var s = sh_('MA_SP'); p.ma = String(p.ma || '').trim(); if (!p.ma) throw new Error('Chưa nhập Mã hàng.'); if (/\s/.test(p.ma)) throw new Error('Mã hàng không được chứa khoảng trắng.'); if (!String(p.ten || '').trim()) throw new Error('Chưa nhập Tên sản phẩm.'); var row = findRowByKey_('MA_SP', 1, 5, p.ma); if (row < 0) { row = firstEmptyRow_('MA_SP', 1, 5); ensureFormulas_('MA_SP', 5, row, [7, 8, 9, 11, 12, 13, 14, 15, 16]); } s.getRange(row, 1).setValue(p.ma); s.getRange(row, 2).setValue(p.ten); if (p.hinh) s.getRange(row, 3).setValue(p.hinh); s.getRange(row, 4).setValue(p.link || ''); s.getRange(row, 5).setValue(money_(p.giaTe)); s.getRange(row, 6).setValue(money_(p.shipDV)); s.getRange(row, 10).setValue(money_(p.giaBan)); return getProducts(); }
function deleteProduct(tk, ma) { _auth(tk); requireRole_(['Admin']); var s = sh_('DON_HANG'); var co = false; if (s && s.getLastRow() >= 5) { co = s.getRange(5, 5, s.getLastRow() - 4, 1).getValues().some(function (r) { return String(r[0]) === String(ma); }); } if (co) throw new Error('Hàng đã có trong đơn — không xoá để tránh mất lịch sử.'); var row = findRowByKey_('MA_SP', 1, 5, ma); if (row < 0) throw new Error('Không tìm thấy hàng ' + ma); var ms = sh_('MA_SP'); [1, 2, 4, 5, 6, 10].forEach(function (c) { ms.getRange(row, c).clearContent(); }); return getProducts(); }

/* ================= ĐƠN HÀNG ================= */
var _ordersCache = null;
function groupOrders_() { if (_ordersCache) return _ordersCache; var s = sh_('DON_HANG'); var map = {}, list = []; if (s && s.getLastRow() >= 5) { var cm = custMap_(); var v = s.getRange(5, 1, s.getLastRow() - 4, 23).getValues(); v.forEach(function (r) { if (!r[1]) return; var k = String(r[1]); if (!map[k]) { map[k] = { maDon: k, ngay: fmtDate_(r[0]), maKH: String(r[2] || ''), tenKH: (cm[String(r[2] || '')] || {}).ten || String(r[3] || ''), items: [], tongTien: 0, daThu: 0, conNo: 0, lai: 0, trangThai: '', ngayGiao: '', huy: false, loaiHang: '', rowFirst: 0 }; list.push(map[k]); } var o = map[k]; o.items.push({ ma: String(r[4] || ''), ten: String(r[5] || ''), mau: String(r[7] || ''), size: String(r[8] || ''), sl: money_(r[9]), gia: money_(r[10]), giam: money_(r[11]), thanhTien: money_(r[12]), lai: money_(r[19]), tonCo: money_(r[20]), canhBao: String(r[22] || '') }); o.tongTien += money_(r[12]); o.daThu += money_(r[13]); o.lai += money_(r[19]); if (r[17]) o.trangThai = String(r[17]); if (r[15]) o.ngayGiao = fmtDate_(r[15]); if (String(r[16] || '').toLowerCase() === 'x') o.huy = true; if (r[18]) o.loaiHang = String(r[18]); }); } list.forEach(function (o) { o.conNo = Math.max(0, o.tongTien - o.daThu); }); list.sort(function (a, b) { var d = parseDate_(b.ngay) - parseDate_(a.ngay); if (d) return d; var na = parseInt(String(a.maDon).replace(/\D/g, ''), 10) || 0, nb = parseInt(String(b.maDon).replace(/\D/g, ''), 10) || 0; return nb - na; }); _ordersCache = list; return list; }
function getOrders(tk) { _auth(tk); return groupOrders_(); }
function getOrderDetail(tk, maDon) { _auth(tk); var o = null; groupOrders_().forEach(function (x) { if (x.maDon === String(maDon)) o = x; }); if (!o) throw new Error('Không tìm thấy đơn ' + maDon); var cm = custMap_(); return { order: o, customer: cm[o.maKH] || null, config: getShopConfig() }; }
function nextDonNo_() { var s = sh_('DON_HANG'); var max = 0; if (s && s.getLastRow() >= 5) { s.getRange(5, 2, s.getLastRow() - 4, 1).getValues().forEach(function (r) { var m = String(r[0] || '').match(/^DH(\d+)$/i); if (m) { var n = parseInt(m[1], 10); if (n > max) max = n; } }); } var num = String(max + 1); while (num.length < 3) num = '0' + num; return 'DH' + num; }
function orderRows_(maDon) { var s = sh_('DON_HANG'); var rows = []; if (s && s.getLastRow() >= 5) { var v = s.getRange(5, 2, s.getLastRow() - 4, 1).getValues(); for (var i = 0; i < v.length; i++) { if (String(v[i][0]) === String(maDon)) rows.push(5 + i); } } return rows; }
function createOrder(tk, p) { _auth(tk); requireRole_(['Admin', 'BanHang']); if (!p || !p.items || !p.items.length) throw new Error('Giỏ hàng trống.'); var cm = custMap_(); var maKH = String(p.maKH || '').trim(); if (p.newCustomer) { saveCustomer(null, p.newCustomer); cm = custMap_(); maKH = String(p.newCustomer.ma || slugify_(p.newCustomer.ten)); } if (!maKH || !cm[maKH]) throw new Error('Chưa chọn khách hàng hợp lệ.'); var prods = {}; readProducts_().forEach(function (x) { prods[x.ma] = x; }); var maDon = nextDonNo_(); var ngay = p.ngay ? parseDate_(p.ngay) : new Date(); var startRow = firstEmptyRow_('DON_HANG', 2, 5); var s = sh_('DON_HANG'); var daThu = Math.max(0, money_(p.daThu)); p.items.forEach(function (it, idx) { var pr = prods[String(it.ma)]; if (!pr) throw new Error('Không tìm thấy mã hàng ' + it.ma); var row = startRow + idx; ensureFormulas_('DON_HANG', 5, row, [4, 6, 7, 11, 13, 15, 18, 19, 20, 21, 22, 23, 24, 25, 26]); s.getRange(row, 1).setValue(ngay); s.getRange(row, 2).setValue(maDon); s.getRange(row, 3).setValue(maKH); s.getRange(row, 5).setValue(String(it.ma)); s.getRange(row, 8).setValue(String(it.mau || '')); s.getRange(row, 9).setValue(String(it.size || '')); s.getRange(row, 10).setValue(Math.max(1, money_(it.sl) || 1)); s.getRange(row, 12).setValue(Math.max(0, money_(it.giam))); s.getRange(row, 14).setValue(idx === 0 ? daThu : 0); }); SpreadsheetApp.flush(); _ordersCache = null; return getOrderDetail(null, maDon); }
function thuThem(tk, p) { _auth(tk); requireRole_(['Admin', 'BanHang', 'KeToan']); var rows = orderRows_(p.maDon); if (!rows.length) throw new Error('Không tìm thấy đơn ' + p.maDon); var o = null; groupOrders_().forEach(function (x) { if (x.maDon === String(p.maDon)) o = x; }); var tien = money_(p.soTien); if (tien <= 0) throw new Error('Nhập số tiền thu thêm.'); if (o && tien > o.conNo) throw new Error('Số tiền vượt còn nợ của đơn (' + o.conNo + 'đ).'); var s = sh_('DON_HANG'); var r0 = rows[0]; var cur = money_(s.getRange(r0, 14).getValue()); s.getRange(r0, 14).setValue(cur + tien); SpreadsheetApp.flush(); _ordersCache = null; return getOrderDetail(null, p.maDon); }
function giaoHang(tk, maDon, ngayGiao) { _auth(tk); requireRole_(['Admin', 'BanHang', 'Kho']); var rows = orderRows_(maDon); if (!rows.length) throw new Error('Không tìm thấy đơn ' + maDon); var s = sh_('DON_HANG'); var d = ngayGiao ? parseDate_(ngayGiao) : new Date(); rows.forEach(function (r) { s.getRange(r, 16).setValue(d); }); SpreadsheetApp.flush(); _ordersCache = null; return getOrderDetail(null, maDon); }
function huyDon(tk, maDon) { _auth(tk); requireRole_(['Admin', 'BanHang']); var rows = orderRows_(maDon); if (!rows.length) throw new Error('Không tìm thấy đơn ' + maDon); var s = sh_('DON_HANG'); rows.forEach(function (r) { s.getRange(r, 17).setValue('x'); }); SpreadsheetApp.flush(); _ordersCache = null; return getOrderDetail(null, maDon); }
function moLaiDon(tk, maDon) { _auth(tk); requireRole_(['Admin', 'BanHang']); var rows = orderRows_(maDon); if (!rows.length) throw new Error('Không tìm thấy đơn ' + maDon); var s = sh_('DON_HANG'); rows.forEach(function (r) { s.getRange(r, 17).clearContent(); s.getRange(r, 16).clearContent(); }); SpreadsheetApp.flush(); _ordersCache = null; return getOrderDetail(null, maDon); }

/* ================= TỔNG QUAN & TỒN KHO ================= */
function getDashboard(tk) { _auth(tk); var orders = groupOrders_().filter(function (o) { return !o.huy; }); var today = todayStr_(); var now = new Date(); var mY = now.getFullYear() * 100 + (now.getMonth() + 1); function ymOf(dstr) { var d = parseDate_(dstr); return d.getFullYear() * 100 + (d.getMonth() + 1); } function isToday(dstr) { return Utilities.formatDate(parseDate_(dstr), TZ, 'yyyy-MM-dd') === today; } var hn = orders.filter(function (o) { return isToday(o.ngay); }); var th = orders.filter(function (o) { return ymOf(o.ngay) === mY; }); var sum = function (arr, f) { return arr.reduce(function (a, o) { return a + f(o); }, 0); }; var days = []; for (var i = 13; i >= 0; i--) { var d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i); var key = Utilities.formatDate(d, TZ, 'yyyy-MM-dd'); var val = 0; orders.forEach(function (o) { if (Utilities.formatDate(parseDate_(o.ngay), TZ, 'yyyy-MM-dd') === key) val += o.tongTien; }); days.push({ ngay: Utilities.formatDate(d, TZ, 'dd/MM'), tien: val }); } var bcMap = {}; th.forEach(function (o) { o.items.forEach(function (it) { if (!bcMap[it.ma]) bcMap[it.ma] = { ma: it.ma, ten: it.ten, sl: 0, tien: 0 }; bcMap[it.ma].sl += it.sl; bcMap[it.ma].tien += it.thanhTien; }); }); var banChay = Object.keys(bcMap).map(function (k) { return bcMap[k]; }).sort(function (a, b) { return b.tien - a.tien; }).slice(0, 6); var khNo = readCustomers_().filter(function (c) { return c.conNo > 0; }).sort(function (a, b) { return b.conNo - a.conNo; }); var vr = variantRows_(); var tongTon = vr.reduce(function (a, x) { return a + x.ton; }, 0); var canDat = vr.filter(function (x) { return x.canDat > 0 || x.ton < 0; }); var vonMap = {}; readProducts_().forEach(function (p) { vonMap[p.ma] = p.vonBQ || p.vonUoc; }); var giaTriTon = vr.reduce(function (a, x) { return a + Math.max(0, x.ton) * (vonMap[x.ma] || 0); }, 0); var choHang = orders.filter(function (o) { return !o.ngayGiao; }); return { homNay: { soDon: hn.length, doanhThu: sum(hn, function (o) { return o.tongTien; }), daThu: sum(hn, function (o) { return o.daThu; }), conNo: sum(hn, function (o) { return o.conNo; }) }, thangNay: { soDon: th.length, doanhThu: sum(th, function (o) { return o.tongTien; }), lai: sum(th, function (o) { return o.lai; }) }, canXuLy: { donChoHang: choHang.length, khachConNo: khNo.length, tongNo: khNo.reduce(function (a, c) { return a + c.conNo; }, 0), dongCanDat: canDat.length, slCanDat: canDat.reduce(function (a, x) { return a + Math.max(0, x.canDat); }, 0), choVeSL: vr.reduce(function (a, x) { return a + Math.max(0, -x.ton); }, 0) }, chart14: days, banChay: banChay, khachNo: khNo.slice(0, 5), canDatList: canDat.slice(0, 8), donMoiNhat: orders.slice(0, 8), tonKho: { tongTon: tongTon, giaTriTon: giaTriTon, soDong: vr.length }, tyGia: tyGiaMoi_(), homNayStr: Utilities.formatDate(now, TZ, 'dd/MM/yyyy'), thangStr: (now.getMonth() + 1) + '/' + now.getFullYear() }; }
function getStock(tk) { _auth(tk); return { variants: variantRows_(), products: readProducts_() }; }
